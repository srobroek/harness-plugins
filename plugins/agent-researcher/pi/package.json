{
  "name": "@srobroek/pi-agent-researcher",
  "version": "0.12.2",
  "description": "The researcher subagent: answers one scoped question from code, docs and the web with cited observations and inferences, and records it on a bead when given one.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srobroek/harness-plugins.git",
    "directory": "plugins/agent-researcher/pi"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "_kit",
    "agents"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@srobroek/pi-repomix": "*",
    "pi-lens": "*",
    "pi-subagents": "*",
    "pi-web-access": "*"
  },
  "peerDependenciesMeta": {
    "@srobroek/pi-repomix": {
      "optional": true
    },
    "pi-lens": {
      "optional": true
    },
    "pi-subagents": {
      "optional": true
    },
    "pi-web-access": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./_kit/prereqs.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
