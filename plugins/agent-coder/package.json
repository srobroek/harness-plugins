{
  "name": "agent-coder",
  "version": "0.14.1",
  "description": "coder subagent for any code development task (implement, fix, debug, test, build, profile, upgrade deps) with only coding tools and skills.",
  "private": true,
  "type": "module",
  "agent-plugins": {
    "description": "coder subagent for any code development task (implement, fix, debug, test, build, profile, upgrade deps) with only coding tools and skills.",
    "category": "development",
    "harnesses": [
      "opencode",
      "pi"
    ],
    "scope": "global",
    "entries": {
      "index": "index"
    },
    "companions": [
      {
        "package": "pi-subagents",
        "for": "the subagent tool",
        "required": true
      },
      {
        "package": "pi-lens",
        "for": "code-intelligence tools for the subagent",
        "required": true
      },
      {
        "package": "pi-web-access",
        "for": "web search and fetch tools for the subagent",
        "required": true
      },
      {
        "package": "@srobroek/pi-code-quality",
        "for": "read-only test report analysis tools",
        "required": true
      },
      {
        "package": "@srobroek/pi-dep-update",
        "for": "dependency scan and apply tools",
        "required": true
      },
      {
        "package": "@srobroek/pi-whats-new",
        "for": "version gap scan tool",
        "required": true
      }
    ]
  }
}
