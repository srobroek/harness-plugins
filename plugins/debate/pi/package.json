{
  "name": "@srobroek/pi-debate",
  "version": "1.0.1",
  "description": "Stress-test a decision from both sides or grill a plan in frontier rounds.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srobroek/harness-plugins.git",
    "directory": "plugins/debate/pi"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "_kit",
    "agents",
    "commands",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "pi-subagents": "*"
  },
  "peerDependenciesMeta": {
    "pi-subagents": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./_kit/prereqs.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./commands"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
