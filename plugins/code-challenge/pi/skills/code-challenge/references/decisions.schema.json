{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srobroek/harness-plugins/plugins/code-challenge/decisions.schema.json",
  "title": "code-challenge decision",
  "description": "One line of decisions.jsonl. Append-only; one object per line.",
  "type": "object",
  "required": ["ts", "run_id", "phase", "kind", "subject", "choice", "reason", "by"],
  "additionalProperties": false,
  "properties": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9-]{1,24}$" },
    "phase": { "enum": ["INTAKE", "SCAN", "CHALLENGE", "RESEARCH", "REFUTE", "DECIDE", "DELIVER"] },
    "kind": { "enum": ["decision", "blocker", "ambiguity", "choice", "inference"] },
    "subject": { "type": "string", "minLength": 1 },
    "choice": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "by": { "enum": ["user", "agent", "autonomous-rule"] },
    "finding_id": { "type": "string", "pattern": "^F[0-9]+$" },
    "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
