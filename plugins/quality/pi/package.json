    "agents",
    "extensions",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "pi-lens": "*",
    "pi-web-access": "*",
    "typebox": "*"
  },
