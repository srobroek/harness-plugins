{
  "name": "@srobroek/pi-code-quality",
  "version": "0.16.2",
  "description": "Code design and review guidance, a code-quality policy, testing standards and a test audit, performance profiling, and throwaway logic prototypes.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srobroek/harness-plugins.git",
    "directory": "plugins/quality/pi"
  },
