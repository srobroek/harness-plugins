{
  "plugin": "design",
  "prerequisites": [
    {
      "bin": "impeccable",
      "for": "design_impeccable_scan and the upstream impeccable skill pack",
      "required": true,
      "install": {
        "mise": "npm:impeccable",
        "url": "https://github.com/pbakaus/impeccable#readme"
      },
      "version": ">=4.10.0"
    },
    {
      "bin": "npx",
      "for": "the Playwright, accessibility-scanner and wire-dsl MCP servers",
      "required": true,
      "install": {
        "mise": "node",
        "url": "https://nodejs.org/en/download"
      }
    }
  ],
  "companions": [
    {
      "package": "pi-subagents",
      "for": "the design agents, /design-review and /council-product",
      "required": true
    },
    {
      "package": "pi-web-access",
      "for": "web search and fetch in ui-ux-specialist, design-critic and a11y-auditor",
      "required": true
    },
    {
      "package": "@srobroek/pi-debate",
      "for": "council-advocate and council-skeptic in /council-product",
      "required": true
    }
  ]
}
