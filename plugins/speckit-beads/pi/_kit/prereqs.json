{
  "plugin": "speckit-beads",
  "prerequisites": [
    {
      "bin": "bd",
      "for": "the Beads workspace, formulas and task state; the tasks.md guard probes it",
      "required": true,
      "install": {
        "mise": "aqua:gastownhall/beads",
        "url": "https://github.com/gastownhall/beads/blob/main/docs/getting-started/installation.md"
      },
      "version": ">=1.3.0"
    },
    {
      "bin": "specify",
      "for": "speckit_setup's specify init and extension installs",
      "required": false,
      "install": {
        "mise": "pipx:specify-cli",
        "url": "https://github.com/github/spec-kit"
      },
      "version": ">=1.4.0"
    }
  ]
}
