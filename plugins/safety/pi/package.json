{
  "name": "@srobroek/pi-safety",
  "version": "0.14.1",
  "description": "Hard gates and permission checks for destructive, indirect, remote-exec and attributed shell commands, shipped-migration edits and external directory flags, plus close-keyword and package-vetting help and redaction of secret environment values from tool output.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srobroek/harness-plugins.git",
    "directory": "plugins/safety/pi"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "_kit",
    "extensions"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@srobroek/pi-secret-store": "*"
  },
  "peerDependenciesMeta": {
    "@srobroek/pi-secret-store": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/safety.js",
      "./_kit/prereqs.ts"
    ]
  }
}
