{
  "extends": "@srobroek/harness-kit/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "lib": ["ESNext"],
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "tests/*.ts",
    "examples/*/test/**/*.ts",
    "examples/*/.opencode/plugins/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
